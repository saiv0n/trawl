{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trawl",
  "version": "1.0.0",
  "identifier": "app.trawl.downloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Trawl",
        "width": 1320,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 640,
        "decorations": false,
        "visible": false,
        "center": true,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#07070B"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Trawl",
    "shortDescription": "Trawl Download Manager",
    "longDescription": "Çok bağlantılı indirme yöneticisi, medya ve sayfa tarayıcı",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "../extension/": "extension/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Turkish", "English"], "displayLanguageSelector": false }
    }
  }
}
