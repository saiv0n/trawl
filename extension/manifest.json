{
  "manifest_version": 3,
  "name": "Trawl",
  "key": "",
  "version": "1.7.0",
  "description": "Sayfadaki videoyu, sesi ve dosyaları Trawl ile indir.",
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icon16.png", "32": "icon32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["webRequest", "downloads", "contextMenus", "cookies", "storage", "tabs", "scripting", "alarms", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["hook.js"], "all_frames": true, "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["main.js"], "world": "MAIN", "all_frames": true, "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["panel.js"], "all_frames": true, "run_at": "document_idle" },
    { "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://music.youtube.com/*"], "js": ["youtube.js"], "css": ["youtube.css"], "run_at": "document_idle" }
  ]
}
